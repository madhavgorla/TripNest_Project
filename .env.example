# TripNest local environment
DISABLE_HMR=false
# The browser uses this origin for the same-origin Express API gateway.
VITE_API_BASE_URL=http://localhost:3000

# Gemini / AI
GEMINI_API_KEY=

# App and OAuth
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Postgres
DATABASE_URL=

# SMTP / email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TripNest
